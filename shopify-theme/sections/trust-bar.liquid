{% comment %}
  DEXYFIED Slim Trust Bar Section
  4 verified logistical and customer assurance pillars
{% endcomment %}

<section class="reveal-on-scroll" style="border-top: 1px solid var(--border-main); border-bottom: 1px solid var(--border-main); background-color: var(--bg-surface-elevated); padding: 1.75rem 0;">
  <div class="dexy-container">
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;" class="trust-grid">
      <!-- Pillar 1 -->
      <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
        <div style="padding: 0.625rem; border: 1px solid var(--border-main); background: var(--bg-surface); flex-shrink: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
            <path d="M15 18H9"></path>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
            <circle cx="17" cy="18" r="2"></circle>
            <circle cx="7" cy="18" r="2"></circle>
          </svg>
        </div>
        <div>
          <h4 style="font-family: var(--font-tech); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary); margin: 0;">
            {{ section.settings.p1_title | default: 'NATIONWIDE DELIVERY' }}
          </h4>
          <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; line-height: 1.4;">
            {{ section.settings.p1_desc | default: 'Flat PKR 150 across Pakistan via tracked courier' }}
          </p>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
        <div style="padding: 0.625rem; border: 1px solid var(--border-main); background: var(--bg-surface); flex-shrink: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" x2="12" y1="2" y2="22"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div>
          <h4 style="font-family: var(--font-tech); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary); margin: 0;">
            {{ section.settings.p2_title | default: 'COD & PREPAID PAYMENT' }}
          </h4>
          <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; line-height: 1.4;">
            {{ section.settings.p2_desc | default: 'Pay cash on arrival or via Meezan Bank, JazzCash & Easypaisa' }}
          </p>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
        <div style="padding: 0.625rem; border: 1px solid var(--border-main); background: var(--bg-surface); flex-shrink: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
        </div>
        <div>
          <h4 style="font-family: var(--font-tech); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary); margin: 0;">
            {{ section.settings.p3_title | default: '7-DAY RETURN POLICY' }}
          </h4>
          <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; line-height: 1.4;">
            {{ section.settings.p3_desc | default: 'Straightforward returns on unused items in original packaging' }}
          </p>
        </div>
      </div>

      <!-- Pillar 4 -->
      <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
        <div style="padding: 0.625rem; border: 1px solid var(--border-main); background: var(--bg-surface); flex-shrink: 0; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          </svg>
        </div>
        <div>
          <h4 style="font-family: var(--font-tech); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-primary); margin: 0;">
            {{ section.settings.p4_title | default: 'WHATSAPP ASSISTANCE' }}
          </h4>
          <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; line-height: 1.4;">
            {{ section.settings.p4_desc | default: '+92 319 4389617 direct support & order confirmation' }}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [
    { "type": "text", "id": "p1_title", "label": "Pillar 1 Title", "default": "NATIONWIDE DELIVERY" },
    { "type": "text", "id": "p1_desc", "label": "Pillar 1 Detail", "default": "Flat PKR 150 across Pakistan via tracked courier" },
    { "type": "text", "id": "p2_title", "label": "Pillar 2 Title", "default": "COD & PREPAID PAYMENT" },
    { "type": "text", "id": "p2_desc", "label": "Pillar 2 Detail", "default": "Pay cash on arrival or via Meezan Bank, JazzCash & Easypaisa" },
    { "type": "text", "id": "p3_title", "label": "Pillar 3 Title", "default": "7-DAY RETURN POLICY" },
    { "type": "text", "id": "p3_desc", "label": "Pillar 3 Detail", "default": "Straightforward returns on unused items in original packaging" },
    { "type": "text", "id": "p4_title", "label": "Pillar 4 Title", "default": "WHATSAPP ASSISTANCE" },
    { "type": "text", "id": "p4_desc", "label": "Pillar 4 Detail", "default": "+92 319 4389617 direct support & order confirmation" }
  ],
  "presets": [
    { "name": "Trust Bar" }
  ]
}
{% endschema %}
