{% comment %}
  DEXYFIED Product Reviews Section
  Redesigned to match the aesthetic quality of the Contact page "Send a Direct Message" form:
  - Collapsible review form (hidden by default, opens cleanly on "Write a Review" click)
  - Clean surface, crisp borders, and balanced proportions
  - Touchscreen and keyboard-accessible 5-star rating selector
  - Verified buyer badges, clean review feed, and tasteful empty state
  - Official Shopify App hook (#shopify-product-reviews) for Judge.me / Shopify Reviews integration
{% endcomment %}

<section class="product-reviews-section" id="ProductReviews" data-product-reviews-section data-product-handle="{{ product.handle }}">
  <div class="dexy-container" style="max-width: 56rem;">
    <!-- Section Header & Rating Summary -->
    <div class="reviews-header-bar">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.375rem; font-weight: 700;">
          <span class="status-dot status-dot-blue"></span>
          <span>CUSTOMER FEEDBACK // HARDWARE REVIEWS</span>
        </div>
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 4vw, 1.875rem); text-transform: uppercase; color: var(--text-primary); margin: 0; line-height: 1.2;">
          Customer Reviews
        </h2>
      </div>

      <!-- Rating Summary Pill & Action Button -->
      <div class="reviews-summary-actions">
        <div class="reviews-stats-pill" data-reviews-stats>
          <div class="star-group" data-stars-summary aria-label="Average star rating">
            {% for i in (1..5) %}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#CBD5E1" stroke="#CBD5E1" class="star-icon">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            {% endfor %}
          </div>
          <div style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-primary); font-weight: 600;">
            <span data-avg-rating style="font-weight: 700;">0.0</span> / 5.0
            <span style="color: var(--text-muted); margin-left: 0.25rem;" data-total-reviews-count>(0 reviews)</span>
          </div>
        </div>

        <button
          type="button"
          class="btn-tech-primary"
          data-open-review-form
          style="padding: 0.625rem 1.125rem; font-size: 0.6875rem; min-height: 42px; display: inline-flex; align-items: center; gap: 0.375rem;"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>WRITE A REVIEW</span>
        </button>
      </div>
    </div>

    <!-- Collapsible Review Form Card (Hidden by default, styled like Contact "Send a Direct Message") -->
    <div
      class="review-form-collapsible"
      data-review-form-panel
      id="ProductReviewForm"
      style="display: none;"
    >
      <div class="review-form-card contact-form-card" style="margin-top: 2rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.25rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700;">
            <span class="status-dot status-dot-blue"></span>
            <span>CUSTOMER REVIEW FORM</span>
          </div>
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase;">
            ITEM: {{ product.title | truncate: 32 }}
          </span>
        </div>

        <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 0.25rem 0;">
          Write A Customer Review
        </h3>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin: 0 0 1.5rem 0;">
          Share your real-world experience with this product to assist prospective buyers.
        </p>

        <!-- Feedback Messages Container -->
        <div class="review-feedback-msg" data-review-feedback-msg style="display: none;"></div>

        <form id="ProductReviewSubmissionForm" data-review-form>
          <!-- Star Rating Selector -->
          <div style="margin-bottom: 1.25rem;">
            <label class="form-label" id="rating-label">
              Overall Rating *
            </label>
            <div
              class="interactive-star-rating"
              data-interactive-stars
              role="radiogroup"
              aria-labelledby="rating-label"
              tabindex="0"
            >
              {% for star in (1..5) %}
                <button
                  type="button"
                  class="star-btn"
                  data-star-val="{{ star }}"
                  role="radio"
                  aria-checked="false"
                  aria-label="{{ star }} out of 5 stars"
                  title="{{ star }} stars"
                >
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                </button>
              {% endfor %}
              <span
                class="rating-label-chip"
                data-star-rating-text
              >
                SELECT RATING (1 TO 5 STARS)
              </span>
            </div>
            <input type="hidden" name="rating" id="SelectedRatingValue" value="0" required>
          </div>

          <!-- 2-Column Grid: Name & Optional Headline -->
          <div class="form-grid-2">
            <div>
              <label for="ReviewAuthor" class="form-label">
                Your Display Name *
              </label>
              <input
                type="text"
                id="ReviewAuthor"
                name="name"
                required
                maxlength="60"
                placeholder="e.g. Tariq Ahmed"
                class="form-input"
              >
            </div>

            <div>
              <label for="ReviewTitle" class="form-label">
                Review Headline (Optional)
              </label>
              <input
                type="text"
                id="ReviewTitle"
                name="title"
                maxlength="80"
                placeholder="e.g. Solid build quality, clean metal finish"
                class="form-input"
              >
            </div>
          </div>

          <!-- Customer Email Address -->
          <div style="margin-top: 1.25rem;">
            <label for="ReviewEmail" class="form-label">
              Email Address (Private — will not be published) *
            </label>
            <input
              type="email"
              id="ReviewEmail"
              name="email"
              required
              placeholder="name@example.com"
              class="form-input font-tech"
            >
          </div>

          <!-- Detailed Written Review -->
          <div style="margin-top: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; width: 100%;">
              <label for="ReviewBody" class="form-label" style="margin-bottom: 0; width: auto;">
                Detailed Feedback *
              </label>
              <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); flex-shrink: 0;" data-char-count>
                0 / 1000
              </span>
            </div>
            <textarea
              id="ReviewBody"
              name="body"
              rows="5"
              required
              minlength="10"
              maxlength="1000"
              placeholder="Describe product build, packaging, performance, or everyday utility..."
              class="form-input"
              style="resize: vertical; min-height: 120px;"
            ></textarea>
          </div>

          <!-- Action Buttons: Submit & Cancel -->
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 1.25rem; flex-wrap: wrap;">
            <button
              type="submit"
              class="btn-tech-primary"
              style="flex: 1; min-height: 48px; padding: 0.875rem 1rem; font-size: 0.75rem; letter-spacing: 0.08em; display: flex; align-items: center; justify-content: center; gap: 0.5rem;"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span>SUBMIT CUSTOMER REVIEW</span>
            </button>
            <button
              type="button"
              class="btn-tech"
              data-close-review-form
              style="min-height: 48px; padding: 0.875rem 1.25rem; font-size: 0.75rem;"
            >
              CANCEL
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Official Shopify App Compatibility Anchors (Judge.me, Loox, Spr) -->
    <div id="shopify-product-reviews" data-id="{{ product.id }}" style="margin-top: 1.5rem;">
      {{ product.metafields.spr.reviews }}
    </div>

    {%- if product.metafields.judgeme.widget != blank -%}
      <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" style="margin-top: 1.5rem;">
        {{ product.metafields.judgeme.widget }}
      </div>
    {%- endif -%}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          <div class="reviews-app-block" style="margin-top: 1.5rem;" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
      {% endcase %}
    {% endfor %}

    <!-- Reviews Display Section -->
    <div class="reviews-feed-wrapper" style="margin-top: 2rem;">
      <!-- Dynamic Reviews List Container -->
      <div data-reviews-list style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Injected via JavaScript from verified submissions -->
      </div>

      <!-- Tasteful Empty State Card -->
      <div class="reviews-empty-state" data-reviews-empty>
        <div style="display: flex; justify-content: center; color: var(--warning-color); margin-bottom: 0.75rem; gap: 4px;">
          {% for i in (1..5) %}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#CBD5E1" stroke="#CBD5E1">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          {% endfor %}
        </div>
        <h5 style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 0.375rem 0;">
          No customer reviews yet
        </h5>
        <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); max-width: 26rem; margin: 0 auto 1.25rem auto; line-height: 1.5;">
          Have you tested the {{ product.title }}? Be the first to share your thoughts and help fellow shoppers.
        </p>
        <button
          type="button"
          class="btn-tech"
          data-open-review-form
          style="padding: 0.625rem 1.25rem; font-size: 0.6875rem; min-height: 42px; display: inline-flex; align-items: center; gap: 0.375rem; margin: 0 auto;"
        >
          <span>WRITE THE FIRST REVIEW →</span>
        </button>
      </div>
    </div>

    <!-- Customer Verified Notice Footnote -->
    <div class="reviews-disclosure-footnote">
      <span style="font-weight: 600; color: var(--text-primary);">VERIFIED PURCHASES //</span>
      All customer reviews are submitted by verified DEXYFIED hardware purchasers.
    </div>
  </div>
</section>

<style>
  .product-reviews-section {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--border-main);
    background-color: var(--bg-surface);
  }
  .reviews-header-bar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-main);
  }
  @media (min-width: 768px) {
    .reviews-header-bar {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .reviews-summary-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .reviews-stats-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
  }
  .star-group {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .interactive-star-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    outline: none;
    padding: 0.25rem 0;
  }
  .interactive-star-rating:focus-visible {
    outline: 2px solid var(--accent-blue);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .star-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--border-bright);
    transition: transform 0.15s ease, color 0.15s ease;
    background: transparent;
    border: none;
    border-radius: var(--radius-xs);
  }
  .star-btn:focus-visible {
    outline: 2px solid var(--accent-blue);
    outline-offset: 2px;
  }
  .star-btn:hover {
    transform: scale(1.15);
  }
  .star-btn.active, .star-btn.hovered {
    color: var(--warning-color);
  }
  .star-btn.active svg, .star-btn.hovered svg {
    fill: var(--warning-color);
    stroke: var(--warning-color);
  }
  .rating-label-chip {
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    color: var(--text-dim);
    font-weight: 700;
    margin-left: 0.5rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-main);
    border-radius: var(--radius-xs);
  }
  .single-review-card {
    padding: 1.25rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: border-color 0.2s ease;
  }
  @media (min-width: 640px) {
    .single-review-card {
      padding: 1.5rem;
    }
  }
  .single-review-card:hover {
    border-color: var(--border-bright);
  }
  .reviews-empty-state {
    padding: 2.5rem 1.5rem;
    text-align: center;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
  }
  .reviews-disclosure-footnote {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-main);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--text-dim);
    line-height: 1.6;
  }
  .review-feedback-msg {
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-tech);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .review-form-card,
  .contact-form-card {
    padding: 1.25rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
  }
  @media (min-width: 640px) {
    .review-form-card,
    .contact-form-card {
      padding: 2rem;
    }
  }
  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }
  @media (min-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }
  .form-label {
    display: block;
    width: 100%;
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-main);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    padding: 0.6875rem 0.875rem;
    border-radius: var(--radius-xs);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 44px;
  }
  .form-input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 1px var(--accent-blue);
  }
  .form-input::placeholder {
    color: var(--text-dim);
  }
  textarea.form-input {
    min-height: 110px;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Product Reviews",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
