<header class="header-main">
  <div class="dexy-container">
    <div class="header-inner">
      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="header-logo-link" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; min-width: 0;">
        <div style="background-color: #09090B; padding: 2px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: height: 36 }}"
              alt="{{ shop.name }}"
              width="120"
              height="36"
              style="height: 2rem; width: auto; object-fit: contain;"
            >
          {% else %}
            <img
              src="{{ 'dexyfied-logo-raw.jpg' | asset_url }}"
              alt="DEXYFIED Mark"
              width="40"
              height="36"
              style="height: 2rem; width: auto; object-fit: contain; mix-blend-mode: screen; filter: contrast(1.25) brightness(1.1);"
            >
          {% endif %}
        </div>
        <div style="display: flex; flex-direction: column; justify-content: center; line-height: 1; min-width: 0;">
          <span class="header-brand-name">
            {{ shop.name | default: 'DEXYFIED' }}
          </span>
          <span class="header-brand-sub">
            HARDWARE // PAKISTAN
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      {%- liquid
        assign menu_links = linklists[section.settings.menu].links
        assign has_about = false
        assign has_contact = false

        for link in menu_links
          assign l_url = link.url | downcase
          assign l_title = link.title | downcase
          if l_url contains 'about' or l_title contains 'about'
            assign has_about = true
          endif
          if l_url contains 'contact' or l_title contains 'contact'
            assign has_contact = true
          endif
        endfor
      -%}

      <nav class="nav-links" style="display: none;">
        {% if menu_links.size > 0 %}
          {% for link in menu_links %}
            {% assign l_url = link.url | downcase %}
            {% assign l_title = link.title | downcase %}
            {% unless l_url contains 'categor' or l_title contains 'categor' or l_url == routes.collections_url %}
              <a
                href="{{ link.url }}"
                class="nav-link {% if link.active or request.path == link.url %}active{% endif %}"
              >
                {{ link.title }}
              </a>
            {% endunless %}
          {% endfor %}
          {% unless has_about %}
            <a href="/pages/about" class="nav-link {% if request.path contains '/pages/about' %}active{% endif %}">
              About
            </a>
          {% endunless %}
          {% unless has_contact %}
            <a href="/pages/contact" class="nav-link {% if request.path contains '/pages/contact' %}active{% endif %}">
              Contact
            </a>
          {% endunless %}
        {% else %}
          <a href="{{ routes.root_url }}" class="nav-link {% if request.path == routes.root_url %}active{% endif %}">Home</a>
          <a href="{{ routes.all_products_collection_url }}" class="nav-link {% if request.path == routes.all_products_collection_url %}active{% endif %}">Catalog</a>
          <a href="/pages/about" class="nav-link {% if request.path contains '/pages/about' %}active{% endif %}">About</a>
          <a href="/pages/contact" class="nav-link {% if request.path contains '/pages/contact' %}active{% endif %}">Contact</a>
        {% endif %}
      </nav>

      <!-- Actions (Theme Toggle + Search + Cart + Mobile Hamburger) -->
      <div style="display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0;">
        <!-- Dark/Light Mode Switcher (Visible on desktop/tablet, hidden on mobile where it's in the mobile menu) -->
        <button
          type="button"
          data-theme-toggle
          class="btn-tech header-theme-toggle"
          aria-label="Toggle theme mode"
          title="Toggle dark/light theme"
        >
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <!-- Search Trigger -->
        <button
          type="button"
          data-search-trigger
          class="btn-tech header-action-btn"
          aria-label="Search catalog"
          title="Search products"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Cart Bag Trigger -->
        <button
          type="button"
          data-cart-open
          class="btn-tech header-cart-btn"
          aria-label="Open cart bag"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span style="font-family: var(--font-tech); font-weight: 700; font-size: 0.75rem;">
            [<span data-cart-count>{{ cart.item_count }}</span>]
          </span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          data-mobile-menu-toggle
          class="btn-tech header-action-btn md-hidden"
          aria-label="Toggle navigation menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div
    data-mobile-menu
    class="hidden"
    style="display: none; border-top: 1px solid var(--border-main); background: var(--bg-surface); padding: 1.25rem 1rem; box-shadow: var(--shadow-md);"
  >
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      {% if menu_links.size > 0 %}
        {% for link in menu_links %}
          {% assign l_url = link.url | downcase %}
          {% assign l_title = link.title | downcase %}
          {% unless l_url contains 'categor' or l_title contains 'categor' or l_url == routes.collections_url %}
            <a
              href="{{ link.url }}"
              class="mobile-menu-item"
              style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center; border-radius: var(--radius-xs); color: {% if link.active or request.path == link.url %}var(--accent-blue){% else %}var(--text-primary){% endif %}; font-weight: {% if link.active or request.path == link.url %}700{% else %}500{% endif %}; background: {% if link.active or request.path == link.url %}var(--bg-surface-elevated){% else %}transparent{% endif %};"
            >
              {{ link.title }}
            </a>
          {% endunless %}
        {% endfor %}
        {% unless has_about %}
          <a
            href="/pages/about"
            class="mobile-menu-item"
            style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center; border-radius: var(--radius-xs); color: {% if request.path contains '/pages/about' %}var(--accent-blue){% else %}var(--text-primary){% endif %}; font-weight: {% if request.path contains '/pages/about' %}700{% else %}500{% endif %}; background: {% if request.path contains '/pages/about' %}var(--bg-surface-elevated){% else %}transparent{% endif %};"
          >
            About
          </a>
        {% endunless %}
        {% unless has_contact %}
          <a
            href="/pages/contact"
            class="mobile-menu-item"
            style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center; border-radius: var(--radius-xs); color: {% if request.path contains '/pages/contact' %}var(--accent-blue){% else %}var(--text-primary){% endif %}; font-weight: {% if request.path contains '/pages/contact' %}700{% else %}500{% endif %}; background: {% if request.path contains '/pages/contact' %}var(--bg-surface-elevated){% else %}transparent{% endif %};"
          >
            Contact
          </a>
        {% endunless %}
      {% else %}
        <a href="{{ routes.root_url }}" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center;">Home</a>
        <a href="{{ routes.all_products_collection_url }}" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center;">Catalog</a>
        <a href="/pages/about" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center;">About</a>
        <a href="/pages/contact" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.625rem 0.75rem; min-height: 44px; display: flex; align-items: center;">Contact</a>
      {% endif %}
    </div>

    <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-main); font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); display: flex; flex-direction: column; gap: 0.625rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span>THEME MODE:</span>
        <button type="button" data-theme-toggle class="btn-tech" style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 38px;">
          SWITCH THEME
        </button>
      </div>
      <div>SUPPORT: +92 319 4389617</div>
      <div>FLAT PKR 150 SHIPPING NATIONWIDE</div>
    </div>
  </div>
</header>

<style>
  .header-brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-primary);
    white-space: nowrap;
  }
  @media (max-width: 380px) {
    .header-brand-name {
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
    }
  }
  @media (min-width: 640px) {
    .header-brand-name {
      font-size: 1.25rem;
      letter-spacing: 0.18em;
    }
  }
  .header-brand-sub {
    font-family: var(--font-tech);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-top: 2px;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .header-brand-sub {
      display: none;
    }
  }
  .header-action-btn {
    min-width: 38px;
    min-height: 38px;
    padding: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-color: var(--border-main);
  }
  @media (max-width: 360px) {
    .header-action-btn {
      min-width: 34px;
      min-height: 34px;
      padding: 0.25rem;
    }
  }
  .header-theme-toggle {
    min-width: 40px;
    min-height: 40px;
    padding: 0.5rem;
    display: none;
    align-items: center;
    justify-content: center;
    border-color: var(--border-main);
  }
  .header-cart-btn {
    min-height: 40px;
    padding: 0.5rem 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--bg-surface);
    border-color: var(--border-main);
  }
  @media (min-width: 768px) {
    .nav-links { display: flex !important; }
    .md-hidden { display: none !important; }
    .header-theme-toggle { display: inline-flex !important; }
    .header-action-btn, .header-theme-toggle, .header-cart-btn {
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
