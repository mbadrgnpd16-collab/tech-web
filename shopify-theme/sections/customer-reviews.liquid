{% comment %}
  DEXYFIED Customer Feedback & Reviews Section
  100% Genuine reviews from real buyers only.
  - Zero fabricated or hardcoded reviews.
  - Displays real customer submissions or reviews from installed apps (Judge.me, etc.).
  - Tasteful, honest empty state when awaiting initial customer reviews.
{% endcomment %}

<section class="homepage-reviews-section" style="padding: 3.5rem 0; border-bottom: 1px solid var(--border-main); background-color: var(--bg-surface);">
  <div class="dexy-container">
    <div style="display: flex; flex-direction: column; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-main);" class="section-header-row">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.25rem; font-weight: 700;">
          <span class="status-dot status-dot-blue"></span>
          <span>COMMUNITY FEEDBACK // REAL BUYERS ONLY</span>
        </div>
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 4vw, 1.875rem); text-transform: uppercase; letter-spacing: -0.02em; color: var(--text-primary); margin: 0;">
          Customer Reviews
        </h2>
      </div>

      <a
        href="{{ routes.all_products_collection_url }}"
        style="font-family: var(--font-tech); font-size: 0.75rem; text-transform: uppercase; color: var(--accent-blue); font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 0.75rem;"
      >
        <span>EXPLORE HARDWARE &amp; WRITE REVIEWS</span>
        <span>→</span>
      </a>
    </div>

    {% comment %} Official Shopify App Compatibility (Judge.me Carousel & @app blocks) {% endcomment %}
    {%- if shop.metafields.judgeme.carousel != blank -%}
      <div class="jdgm-carousel-wrapper" data-from-snippet="true" style="margin-bottom: 1.5rem;">
        {{ shop.metafields.judgeme.carousel }}
      </div>
    {%- endif -%}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          <div class="homepage-reviews-app-block" style="margin-bottom: 1.5rem;" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
      {% endcase %}
    {% endfor %}

    <!-- Dynamic Real Customer Reviews Grid (Populated when real submissions exist) -->
    <div class="reviews-grid" data-homepage-reviews-list style="display: none;"></div>

    <!-- Tasteful, Honest Empty State Card (Visible when awaiting first buyer reviews) -->
    <div class="homepage-reviews-empty" data-homepage-reviews-empty style="border: 1px solid var(--border-main); background: var(--bg-surface-subtle); padding: 2.5rem 1.5rem; border-radius: var(--radius-xs); text-align: center; box-shadow: var(--shadow-2xs);">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; margin-bottom: 0.75rem;">
        <span class="status-dot status-dot-green"></span>
        <span>GENUINE VERIFICATION PROTOCOL // NO FAKE REVIEWS</span>
      </div>

      <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        Only Real Reviews From Verified Buyers
      </h3>

      <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); max-width: 34rem; margin: 0 auto 1.5rem auto; line-height: 1.6;">
        We strictly publish genuine feedback from verified customers. Reviews for our laptop stands, smartwatches, and audio hardware will appear here as customers receive, unbox, and test their orders.
      </p>

      <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a
          href="{{ routes.all_products_collection_url }}"
          class="btn-tech-primary"
          style="padding: 0.625rem 1.25rem; font-size: 0.6875rem; min-height: 42px; display: inline-flex; align-items: center; gap: 0.375rem;"
        >
          <span>BROWSE HARDWARE CATALOG →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 1.5rem;
    }
  }
  .homepage-review-card {
    border: 1px solid var(--border-main);
    background: var(--bg-surface-subtle);
    padding: 1.5rem;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .homepage-review-card:hover {
    border-color: var(--border-bright);
    transform: translateY(-2px);
  }
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Customer Reviews Section"
    }
  ]
}
{% endschema %}
