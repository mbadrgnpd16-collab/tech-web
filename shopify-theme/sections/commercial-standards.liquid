{% comment %}
  DEXYFIED Commercial Standards Section
  Transparent foundation: Honest pricing, flat PKR 150 nationwide delivery, 7-day return assurance
{% endcomment %}

<section style="padding: 3.5rem 0; background-color: var(--bg-surface-elevated);">
  <div class="dexy-container">
    <div style="max-width: 44rem;">
      <span style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; font-weight: 700;">
        WHY DEXYFIED // COMMERCIAL STANDARDS
      </span>
      <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 2rem; text-transform: uppercase; color: var(--text-primary); margin: 0; line-height: 1.15;">
        Honest specifications. Practical technology. Direct nationwide access.
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 2.5rem;" class="standards-grid">
      <!-- Card 1 -->
      <div style="border: 1px solid var(--border-main); background: var(--bg-surface); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
        <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">
          01 // PRICING
        </div>
        <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--text-primary); text-transform: uppercase; margin: 0;">
          Accurate Original vs Sale
        </h3>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          We state raw original pricing and real promotional sale figures clearly. No inflated baseline markups and no hidden charges added at checkout.
        </p>
      </div>

      <!-- Card 2 -->
      <div style="border: 1px solid var(--border-main); background: var(--bg-surface); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
        <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">
          02 // DELIVERY
        </div>
        <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--text-primary); text-transform: uppercase; margin: 0;">
          Flat PKR 150 Nationwide
        </h3>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Whether you order to Karachi, Lahore, Islamabad, Peshawar, Quetta, or any other town across Pakistan, shipping is charged at a flat PKR 150 fee.
        </p>
      </div>

      <!-- Card 3 -->
      <div style="border: 1px solid var(--border-main); background: var(--bg-surface); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
        <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">
          03 // ASSURANCE
        </div>
        <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--text-primary); text-transform: uppercase; margin: 0;">
          7-Day Return Window
        </h3>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Inspect your hardware upon arrival. If the item is unused and kept in original packaging, you have 7 calendar days to contact our team for assistance.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .standards-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Commercial Standards",
  "settings": [],
  "presets": [
    {
      "name": "Commercial Standards Foundation"
    }
  ]
}
{% endschema %}
