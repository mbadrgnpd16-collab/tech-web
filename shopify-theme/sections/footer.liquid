<footer style="background-color: var(--bg-surface); border-top: 1px solid var(--border-main); color: var(--text-primary); padding-top: 3.5rem; padding-bottom: 5rem;">
  <div class="dexy-container">
    <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;" class="footer-grid">
      <!-- Brand Column -->
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.75rem;">
          <div style="background-color: #09090B; padding: 2px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-main);">
            <img
              src="{{ 'dexyfied-logo-raw.jpg' | asset_url }}"
              alt="DEXYFIED Mark"
              width="48"
              height="40"
              style="height: 2.5rem; width: auto; object-fit: contain; mix-blend-mode: screen; filter: contrast(1.25) brightness(1.1);"
            >
          </div>
          <div style="display: flex; flex-direction: column; justify-content: center; line-height: 1;">
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-primary);">
              DEXYFIED
            </span>
            <span style="font-family: var(--font-tech); font-size: 0.6875rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--text-dim); margin-top: 3px;">
              HARDWARE // PAKISTAN
            </span>
          </div>
        </div>

        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; max-width: 24rem; margin: 0;">
          Practical consumer technology selected for everyday durability and utility. Honest specifications, direct pricing, and PKR 150 nationwide shipping across Pakistan.
        </p>

        <div style="padding-top: 0.5rem;">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); letter-spacing: 0.08em; text-transform: uppercase; display: block;">
            NATIONAL LOGISTICS STATUS:
          </span>
          <span style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-primary); text-transform: uppercase; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; font-weight: 500;">
            <span class="status-dot status-dot-green"></span>
            COURIER DISPATCH ACTIVE // NATIONWIDE (PKR 150)
          </span>
        </div>
      </div>

      <!-- Catalog Column -->
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <h4 style="font-family: var(--font-tech); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-primary); font-weight: 700; margin: 0;">
          CATALOG
        </h4>
        {%- liquid
          assign ws_url = '/collections/all?category=workspace'
          if collections['workspace'] != blank and collections['workspace'].products_count > 0
            assign ws_url = collections['workspace'].url
          endif

          assign audio_url = '/collections/all?category=audio'
          if collections['audio'] != blank and collections['audio'].products_count > 0
            assign audio_url = collections['audio'].url
          endif

          assign sw_url = '/collections/all?category=smart+watches'
          if collections['smart-watches'] != blank and collections['smart-watches'].products_count > 0
            assign sw_url = collections['smart-watches'].url
          endif

          assign wear_url = '/collections/all?category=wearables'
          if collections['wearables'] != blank and collections['wearables'].products_count > 0
            assign wear_url = collections['wearables'].url
          endif
        -%}
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.75rem; color: var(--text-muted);">
          <li><a href="{{ routes.all_products_collection_url }}" class="footer-nav-link">All Hardware Products</a></li>
          <li><a href="{{ ws_url }}" class="footer-nav-link">Workspace Gear</a></li>
          <li><a href="{{ audio_url }}" class="footer-nav-link">Audio &amp; Cases</a></li>
          <li><a href="{{ sw_url }}" class="footer-nav-link">Smart Watches</a></li>
          <li><a href="{{ wear_url }}" class="footer-nav-link">Wearables</a></li>
        </ul>
      </div>

      <!-- Policies Column -->
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <h4 style="font-family: var(--font-tech); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-primary); font-weight: 700; margin: 0;">
          POLICIES &amp; INFO
        </h4>
        {%- liquid
          assign refund_url = shop.refund_policy.url | default: '/pages/refund-policy'
          assign shipping_url = shop.shipping_policy.url | default: '/pages/shipping-policy'
          assign privacy_url = shop.privacy_policy.url | default: '/pages/privacy-policy'
          assign terms_url = shop.terms_of_service.url | default: '/pages/terms'
        -%}
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.75rem; color: var(--text-muted);">
          <li><a href="/pages/about" class="footer-nav-link">About DEXYFIED</a></li>
          <li><a href="/pages/contact" class="footer-nav-link">Contact Support Desk</a></li>
          <li><a href="{{ refund_url }}" class="footer-nav-link">7-Day Refund Policy</a></li>
          <li><a href="{{ shipping_url }}" class="footer-nav-link">Shipping Policy</a></li>
          <li><a href="{{ privacy_url }}" class="footer-nav-link">Privacy Policy</a></li>
          <li><a href="{{ terms_url }}" class="footer-nav-link">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Direct Contact Column -->
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <h4 style="font-family: var(--font-tech); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-primary); font-weight: 700; margin: 0;">
          DIRECT CONTACT
        </h4>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.75rem; color: var(--text-muted);">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span>EMAIL:</span>
            <a href="mailto:dexyfied@gmail.com" style="color: var(--text-primary); font-family: var(--font-tech); padding: 0.25rem 0;">dexyfied@gmail.com</a>
          </div>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span>PHONE:</span>
            <a href="tel:+923194389617" style="color: var(--text-primary); font-family: var(--font-tech); padding: 0.25rem 0;">+92 319 4389617</a>
          </div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
            <a href="https://wa.me/923194389617" target="_blank" rel="noopener noreferrer" style="color: #25D366; font-family: var(--font-tech); font-weight: 700; text-decoration: underline; min-height: 38px; display: inline-flex; align-items: center;">
              WHATSAPP OFFICIAL ↗
            </a>
          </div>
        </div>

        <div style="margin-top: 1rem;">
          <span style="font-family: var(--font-tech); font-size: 0.625rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">
            OFFICIAL CHANNELS
          </span>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="https://www.instagram.com/dexyfied_store/" target="_blank" rel="noopener noreferrer" class="btn-tech" style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 40px; display: inline-flex; align-items: center;">
              INSTAGRAM
            </a>
            <a href="https://www.facebook.com/profile.php?id=61588688573200" target="_blank" rel="noopener noreferrer" class="btn-tech" style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 40px; display: inline-flex; align-items: center;">
              FACEBOOK
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom-bar">
      <div>
        © {{ 'now' | date: '%Y' }} DEXYFIED // ALL RIGHTS RESERVED.
      </div>
      <div>
        TECH THAT EARNS ITS PLACE • NATIONWIDE DELIVERY PAKISTAN
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-nav-link {
    color: inherit;
    display: inline-block;
    padding: 0.25rem 0;
    transition: color 0.15s ease;
  }
  .footer-nav-link:hover {
    color: var(--text-primary);
  }
  .footer-bottom-bar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-main);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  @media (min-width: 640px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  @media (min-width: 600px) and (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 2.25rem !important;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 2fr) minmax(0, 2fr) minmax(0, 3fr) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
