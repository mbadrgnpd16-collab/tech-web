{% comment %}
  DEXYFIED 404 Not Found Section
  Includes intelligent route recovery:
  - If visitor navigates to /pages/about (and page was not created in Shopify Admin yet), automatically renders the official About page
  - If visitor navigates to /pages/contact, automatically renders the official Contact page
  - Otherwise renders clean technical 404 recovery directory
{% endcomment %}

{%- liquid
  assign current_path = request.path | default: '' | downcase
  assign canon_url = canonical_url | default: '' | downcase

  assign is_about_route = false
  if current_path contains 'about' or canon_url contains 'about'
    assign is_about_route = true
  endif

  assign is_contact_route = false
  if current_path contains 'contact' or canon_url contains 'contact'
    assign is_contact_route = true
  endif

  assign is_refund_route = false
  if current_path contains 'refund' or current_path contains 'return' or canon_url contains 'refund' or canon_url contains 'return'
    assign is_refund_route = true
  endif

  assign is_shipping_route = false
  if current_path contains 'shipping' or current_path contains 'delivery' or canon_url contains 'shipping' or canon_url contains 'delivery'
    assign is_shipping_route = true
  endif

  assign is_privacy_route = false
  if current_path contains 'privacy' or canon_url contains 'privacy'
    assign is_privacy_route = true
  endif

  assign is_terms_route = false
  if current_path contains 'terms' or canon_url contains 'terms'
    assign is_terms_route = true
  endif
-%}

{%- if is_about_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 3rem; padding-bottom: 6rem;">
    {% render 'about-block' %}
  </div>
{%- elsif is_contact_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'contact-block' %}
  </div>
{%- elsif is_refund_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'refund' %}
  </div>
{%- elsif is_shipping_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'shipping' %}
  </div>
{%- elsif is_privacy_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'privacy' %}
  </div>
{%- elsif is_terms_route -%}
  <div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'terms' %}
  </div>
{%- else -%}
  <script>
    (function() {
      try {
        var p = (window.location.pathname || '').toLowerCase();
        var target = null;
        if (p.indexOf('about') !== -1) target = '[data-404-about-fallback]';
        else if (p.indexOf('contact') !== -1) target = '[data-404-contact-fallback]';
        else if (p.indexOf('refund') !== -1 || p.indexOf('return') !== -1) target = '[data-404-refund-fallback]';
        else if (p.indexOf('shipping') !== -1 || p.indexOf('delivery') !== -1) target = '[data-404-shipping-fallback]';
        else if (p.indexOf('privacy') !== -1) target = '[data-404-privacy-fallback]';
        else if (p.indexOf('terms') !== -1) target = '[data-404-terms-fallback]';

        if (target) {
          var st = document.createElement('style');
          st.textContent = '[data-404-default]{display:none!important}' + target + '{display:block!important}';
          document.head.appendChild(st);
        }
      } catch(e) {}
    })();
  </script>

  <!-- Dynamic Client-Side Route Recovery Container -->
  <div data-404-about-fallback style="display: none; background-color: var(--bg-surface); padding-top: 3rem; padding-bottom: 6rem;">
    {% render 'about-block' %}
  </div>
  <div data-404-contact-fallback style="display: none; background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'contact-block' %}
  </div>
  <div data-404-refund-fallback style="display: none; background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'refund' %}
  </div>
  <div data-404-shipping-fallback style="display: none; background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'shipping' %}
  </div>
  <div data-404-privacy-fallback style="display: none; background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'privacy' %}
  </div>
  <div data-404-terms-fallback style="display: none; background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
    {% render 'policy-block', policy_type: 'terms' %}
  </div>

  <div data-404-default style="background-color: var(--bg-surface); padding-top: 4rem; padding-bottom: 7rem;">
    <div class="dexy-container" style="max-width: 44rem; text-align: center;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 1rem; padding: 0.25rem 0.625rem; border: 1px solid rgba(0, 102, 255, 0.3); background-color: var(--accent-blue-subtle); border-radius: var(--radius-xs);">
        <span class="status-dot status-dot-blue"></span>
        <span>SYSTEM STATUS // 404 NOT FOUND</span>
      </div>

      <h1 style="font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 5vw, 2.75rem); text-transform: uppercase; color: var(--text-primary); margin: 0 0 1rem 0; line-height: 1.1;">
        Resource Not Located
      </h1>

      <p style="font-family: var(--font-sans); font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; max-width: 32rem; margin: 0 auto 2.5rem auto;">
        The hardware specification, catalog route, or documentation page you requested does not exist or has moved.
      </p>

      <!-- Quick Navigation Recovery Grid -->
      <div class="notfound-grid">
        <a href="{{ routes.all_products_collection_url }}" class="notfound-card">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; font-weight: 700;">DIRECTORY ↗</span>
          <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-transform: uppercase; color: var(--text-primary); margin: 0.25rem 0 0 0;">Browse Full Catalog</h3>
        </a>

        <a href="{{ routes.root_url }}" class="notfound-card">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; font-weight: 700;">STOREFRONT ↗</span>
          <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-transform: uppercase; color: var(--text-primary); margin: 0.25rem 0 0 0;">Return to Homepage</h3>
        </a>

        <a href="/pages/about" class="notfound-card">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">MANIFESTO ↗</span>
          <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-transform: uppercase; color: var(--text-primary); margin: 0.25rem 0 0 0;">About DEXYFIED</h3>
        </a>

        <a href="/pages/contact" class="notfound-card">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--success-color); text-transform: uppercase; font-weight: 700;">SUPPORT DESK ↗</span>
          <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-transform: uppercase; color: var(--text-primary); margin: 0.25rem 0 0 0;">Contact Support</h3>
        </a>
      </div>
    </div>
  </div>

  <style>
    .notfound-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
      text-align: left;
    }
    @media (min-width: 640px) {
      .notfound-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .notfound-card {
      padding: 1.25rem;
      border: 1px solid var(--border-main);
      background-color: var(--bg-surface-subtle);
      border-radius: var(--radius-xs);
      text-decoration: none;
      transition: transform 0.2s ease, border-color 0.2s ease;
      display: flex;
      flex-direction: column;
      min-height: 44px;
    }
    .notfound-card:hover {
      transform: translateY(-2px);
      border-color: var(--text-primary);
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "404 Not Found",
  "settings": []
}
{% endschema %}
