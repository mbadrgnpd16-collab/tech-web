{% comment %}
  DEXYFIED Editorial Page Section
  For About, Contact, Refund Policy, Shipping Policy, Privacy Policy, Terms
  Includes automatic fallback handling for empty Contact and About pages
{% endcomment %}

{%- liquid
  assign p_handle = page.handle | default: '' | downcase
  assign p_title = page.title | default: '' | downcase
  assign p_url = request.path | default: '' | downcase

  assign is_about = false
  if p_handle contains 'about' or p_title contains 'about' or p_url contains 'about' or template.suffix == 'about' or p_handle contains 'story' or p_title contains 'story'
    assign is_about = true
  endif

  assign is_contact = false
  if p_handle contains 'contact' or p_title contains 'contact' or p_url contains 'contact' or template.suffix == 'contact'
    assign is_contact = true
  endif

  assign is_policy = false
  assign policy_kind = ''
  if p_handle contains 'refund' or p_title contains 'refund' or p_url contains 'refund' or p_handle contains 'return' or p_title contains 'return' or p_url contains 'return'
    assign is_policy = true
    assign policy_kind = 'refund'
  elsif p_handle contains 'shipping' or p_title contains 'shipping' or p_url contains 'shipping' or p_handle contains 'delivery'
    assign is_policy = true
    assign policy_kind = 'shipping'
  elsif p_handle contains 'privacy' or p_title contains 'privacy' or p_url contains 'privacy'
    assign is_policy = true
    assign policy_kind = 'privacy'
  elsif p_handle contains 'terms' or p_title contains 'terms' or p_url contains 'terms'
    assign is_policy = true
    assign policy_kind = 'terms'
  endif
-%}

<div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
  {% if is_about %}
    {% render 'about-block' %}
  {% elsif is_contact %}
    {% render 'contact-block' %}
  {% elsif is_policy and page.content == blank %}
    {% render 'policy-block', policy_type: policy_kind %}
  {% elsif page.content != blank %}
    <div class="dexy-container" style="max-width: 48rem;">
      <!-- Page Header -->
      <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-main); margin-bottom: 2.5rem;" class="reveal-on-scroll">
        <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.25rem; font-weight: 700;">
          DEXYFIED DOCUMENTATION // OFFICIAL
        </span>
        <h1 style="font-family: var(--font-display); font-weight: 700; font-size: clamp(1.625rem, 5vw, 2.25rem); text-transform: uppercase; color: var(--text-primary); margin: 0; line-height: 1.15;">
          {{ page.title }}
        </h1>
      </div>

      <!-- Page Content -->
      <div style="font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-primary); line-height: 1.7;" class="page-content reveal-on-scroll">
        {{ page.content }}
      </div>
    </div>
  {% else %}
    {% render 'policy-block', policy_type: policy_kind %}
  {% endif %}
</div>

<style>
  .page-content h2, .page-content h3 {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .page-content p {
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }
  .page-content ul {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }
  .page-content li {
    margin-bottom: 0.5rem;
  }
</style>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
