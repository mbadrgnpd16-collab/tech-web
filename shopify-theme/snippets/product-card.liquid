{% comment %}
  DEXYFIED Product Card Snippet
  Preserves technical reference badge, savings pill, dual-finish / size indicators, and clean layout
{% endcomment %}

{%- liquid
  assign savings = 0
  if product.compare_at_price > product.price
    assign savings = product.compare_at_price | minus: product.price
  endif

  assign ref_tag = 'DX-01'
  for tag in product.tags
    if tag contains 'DX-'
      assign ref_tag = tag
      break
    endif
  endfor

  assign is_laptop_stand = false
  if product.handle contains 'laptop-stand'
    assign is_laptop_stand = true
  endif

  assign is_ring = false
  if product.handle contains 'ring'
    assign is_ring = true
  endif
-%}

<div
  class="product-card group reveal-on-scroll"
  data-product-card
  data-category="{{ product.type | downcase }}"
  data-tags="{{ product.tags | join: ',' | downcase }}"
  data-price="{{ product.price | divided_by: 100 }}"
  data-handle="{{ product.handle }}"
  data-ref="{{ ref_tag }}"
  onclick="window.location.href='{{ product.url }}'"
>
  <!-- Image Frame -->
  <div class="product-card-img-wrap">
    <!-- Ref Badge -->
    <div style="position: absolute; top: 0.625rem; left: 0.625rem; font-family: var(--font-tech); font-size: 0.625rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">
      REF {{ ref_tag }}
    </div>

    <!-- Savings Indicator -->
    {% if savings > 0 %}
      <div style="position: absolute; top: 0.625rem; right: 0.625rem; font-family: var(--font-tech); font-size: 0.625rem; text-transform: uppercase; padding: 0.125rem 0.375rem; border: 1px solid rgba(0, 102, 255, 0.4); color: var(--accent-blue); background-color: var(--accent-blue-subtle); font-weight: 700; border-radius: var(--radius-xs);">
        SAVE {{ savings | money_without_trailing_zeros }}
      </div>
    {% endif %}

    {% if product.featured_media != blank %}
      <img
        src="{{ product.featured_media | image_url: width: 600 }}"
        alt="{{ product.featured_media.alt | default: product.title | escape }}"
        loading="lazy"
        width="300"
        height="300"
      >
    {% else %}
      {%- liquid
        assign fallback_asset = 'dexyfied-logo-raw.jpg' | asset_url
        if product.handle contains 'laptop-stand'
          assign fallback_asset = 'laptop-stand-silver.png' | asset_url
        elsif product.handle contains 'airpods'
          assign fallback_asset = 'airpods-case-black.png' | asset_url
        elsif product.handle contains 'headphones'
          assign fallback_asset = 'wireless-headphones.png' | asset_url
        elsif product.handle contains 'ring'
          assign fallback_asset = 'luminous-ring.png' | asset_url
        elsif product.handle contains 'i9-ultra-max'
          assign fallback_asset = 'i9-ultra-max.png' | asset_url
        elsif product.handle contains 't900'
          assign fallback_asset = 't900-ultra-2.png' | asset_url
        elsif product.handle contains 't800'
          assign fallback_asset = 't800-ultra.png' | asset_url
        endif
      -%}
      <img
        src="{{ fallback_asset }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
        width="300"
        height="300"
      >
    {% endif %}

    <!-- Bottom Indicator Badge -->
    <div style="position: absolute; bottom: 0.625rem; left: 0.625rem; display: flex; align-items: center; gap: 0.375rem;">
      <div style="display: flex; align-items: center; gap: 0.25rem; background: var(--bg-surface); padding: 0.125rem 0.375rem; border: 1px solid var(--border-main); border-radius: var(--radius-xs); box-shadow: var(--shadow-2xs);">
        <span class="status-dot" style="width: 5px; height: 5px;"></span>
        <span style="font-family: var(--font-tech); font-size: 0.625rem; color: var(--text-muted); text-transform: uppercase; font-weight: 500;">
          {% if is_laptop_stand %}
            2 FINISHES
          {% elsif is_ring %}
            SIZES: 6–21
          {% else %}
            IN STOCK
          {% endif %}
        </span>
      </div>
    </div>
  </div>

  <!-- Card Body -->
  <div class="product-card-body">
    <div>
      <div style="display: flex; align-items: center; justify-content: space-between; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; margin-bottom: 0.25rem;">
        <span>{{ product.type | default: 'HARDWARE' }}</span>
        <span style="display: flex; align-items: center; gap: 2px; font-weight: 700; color: var(--accent-blue);">
          VIEW ↗
        </span>
      </div>

      <h3 style="font-family: var(--font-display); font-size: 0.875rem; font-weight: 600; color: var(--text-primary); line-height: 1.25; min-height: 2.2rem; margin: 0;">
        <a href="{{ product.url }}" style="color: inherit;">
          {{ product.title }}
        </a>
      </h3>

      {% if product.metafields.custom.short_statement != blank %}
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
          {{ product.metafields.custom.short_statement }}
        </p>
      {% endif %}
    </div>

    <!-- Pricing & Action -->
    <div style="margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--border-main); display: flex; align-items: center; justify-content: space-between; gap: 0.375rem; flex-wrap: wrap;" class="product-card-footer">
      <div style="display: flex; flex-direction: column; min-width: 0;">
        {% if product.compare_at_price > product.price %}
          <span style="font-family: var(--font-tech); font-size: 0.625rem; color: var(--text-dim); text-decoration: line-through; text-transform: uppercase; white-space: nowrap;">
            {{ product.compare_at_price | money_without_trailing_zeros }}
          </span>
        {% endif %}
        <span style="font-family: var(--font-display); font-size: 0.9375rem; font-weight: 700; color: var(--text-primary); white-space: nowrap;">
          {{ product.price | money_without_trailing_zeros }}
        </span>
      </div>

      <div>
        {% if is_laptop_stand %}
          <a href="{{ product.url }}" class="btn-tech product-card-btn" onclick="event.stopPropagation();">
            <span class="desktop-only-btn-text">CHOOSE COLOR</span>
            <span class="mobile-only-btn-text">COLOR</span>
          </a>
        {% elsif is_ring %}
          <a href="{{ product.url }}" class="btn-tech product-card-btn" onclick="event.stopPropagation();">
            SIZES
          </a>
        {% elsif product.variants.size > 1 %}
          <a href="{{ product.url }}" class="btn-tech product-card-btn" onclick="event.stopPropagation();">
            OPTIONS
          </a>
        {% else %}
          <button
            type="button"
            class="btn-tech product-card-btn"
            onclick="event.stopPropagation(); DexyfiedCart.addToCart({{ product.variants.first.id }}, 1);"
          >
            + CART
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .product-card-body {
    padding: 0.875rem;
  }
  .product-card-btn {
    min-height: 36px;
    padding: 0.375rem 0.5rem;
    font-size: 0.6875rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  .desktop-only-btn-text {
    display: none;
  }
  .mobile-only-btn-text {
    display: inline;
  }
  .product-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
    flex-wrap: wrap;
    width: 100%;
  }
  @media (max-width: 380px) {
    .product-card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .product-card-footer > div:last-child {
      width: 100%;
    }
    .product-card-btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
  @media (min-width: 640px) {
    .product-card-body {
      padding: 1.125rem;
    }
    .product-card-btn {
      padding: 0.375rem 0.625rem;
    }
    .desktop-only-btn-text {
      display: inline;
    }
    .mobile-only-btn-text {
      display: none;
    }
  }
</style>
